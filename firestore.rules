rules_version = '2';

// Intake records are PHI. Nothing is world-readable, and no client may read a
// record without a role assigned in the user collection below.
//
// Two tiers, set by hand in the Firestore Console — no Admin SDK, no service
// account key, no CLI:
//   1. Firebase Console > Authentication > Users > click the person > copy
//      their "User UID".
//   2. Firestore Console > user collection > Add document > set the
//      document ID to that UID > add ONE field: role (string) = "superAdmin"
//      (you) or "admin" (Dr. Antonious).
// Never add a password field here — Firebase Auth already stores it
// securely; mirroring it in a plain document would expose it to anyone with
// Firestore Console access. Revoking access is deleting that document, or
// clearing the role field.
//
// Both tiers may read intake records today; the split exists so that
// higher-privilege actions (staff management, exports, deletion) can be
// gated on superAdmin later without re-plumbing access.
//
// NOTE: writing real patient records to Firestore additionally requires a
// signed Google Cloud BAA covering this project. These rules control access;
// they do not make the storage HIPAA-compliant on their own.
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth != null
        ? get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role
        : '';
    }

    function isStaff() {
      return role() in ['coAdmin', 'admin', 'superAdmin'];
    }

    // Everyone who works with patients: the dietitian, providers and the
    // admin tiers. Gates intake records, charts and notes. isStaff() stays the
    // gate for messages, site analytics and the staff list.
    function isClinical() {
      return role() in ['dietitian', 'provider', 'coAdmin', 'admin', 'superAdmin'];
    }

    // Admits and declines applicants, and writes medical and exercise notes:
    // everyone clinical except the dietitian. Mirrors roles.canAdmit.
    function isAdmitter() {
      return role() in ['provider', 'coAdmin', 'admin', 'superAdmin'];
    }

    // Which role writes which note type. The admin (Dr. Antonious) writes
    // dietitian notes too. Exercise notes are providers' until an exercise
    // role exists. Mirrors roles.canWriteNote.
    function canWriteType(type) {
      return type == 'dietitian' ? role() in ['dietitian', 'admin'] : isAdmitter();
    }

    // The name a person signs with: the `name` on their staff record (set on
    // the Staff page), else their account email. Never the display name they
    // can edit themselves, so a note can't be signed as someone else.
    // Mirrors getAdminAccess() in src/admin/lib/firebase.js.
    function myName() {
      return get(/databases/$(database)/documents/user/$(request.auth.uid)).data.get('name', request.auth.token.get('email', ''));
    }

    // Anyone can post to an open endpoint, so this is the only thing standing
    // between the collection and junk written by a script: the document must
    // have the shape the intake form produces, carry the consents the form
    // requires, and nothing else may be smuggled into it. Sizes are capped so a
    // single submission cannot be used to dump data into the project.
    function isWellFormedIntake() {
      let data = request.resource.data;
      let who = data.demographics;
      return data.keys().hasOnly([
            'submittedAt', 'demographics', 'emergencyContact', 'insurance',
            'vitals', 'medicalHistory', 'familyHistory', 'socialHistory',
            'nutrition', 'visit', 'consent'
          ])
        && who.firstName is string && who.firstName.size() > 0 && who.firstName.size() <= 100
        && who.lastName is string && who.lastName.size() > 0 && who.lastName.size() <= 100
        && who.email is string && who.email.size() > 0 && who.email.size() <= 200
        && who.phone is string && who.phone.size() > 0 && who.phone.size() <= 40
        && who.dateOfBirth is string && who.dateOfBirth.size() > 0
        && data.consent.signature is string && data.consent.signature.size() > 0
        && data.consent.telehealth == true
        && data.consent.hipaaAcknowledged == true;
    }

    // Staff roles (Louie, 2026-10-01). admin is Dr. Antonious; coAdmin is
    // anyone he adds at that level. A signed-in person reads their own role
    // doc. A super admin reads everyone's; an admin or co-admin reads
    // everyone's except super admins', which stay hidden from them. Nobody
    // writes or deletes their own doc, so nobody can promote or remove
    // themselves.
    //   super admin: may set any role, and change or delete anyone.
    //   admin: grants provider, dietitian or co-admin; changes or deletes
    //     providers, dietitians, co-admins and no-access accounts.
    //   co-admin: grants provider, dietitian or co-admin; changes or deletes
    //     only providers, dietitians and no-access accounts.
    // So only a super admin can grant admin or touch the admin, and a
    // co-admin can never remove the admin or another co-admin.
    // Role "" means access removed. Deleting the doc takes the person off the
    // Staff list; their Firebase Auth login itself can only be deleted from
    // the Console (no server here), and signed notes keep the signer's name
    // on the note. The Console, via GCP IAM, bypasses all of this, for the
    // first super admin.
    function canActOn(previousRole) {
      return role() == 'superAdmin'
        || (role() == 'admin' && previousRole in ['', 'provider', 'dietitian', 'coAdmin'])
        || (role() == 'coAdmin' && previousRole in ['', 'provider', 'dietitian']);
    }

    function isRoleChange(uid) {
      let next = request.resource.data;
      let previous = resource == null ? '' : resource.data.get('role', '');
      // What this write sets: every field on a new doc, only the changed ones
      // on an existing doc, so a later role change keeps the original adder.
      let changed = resource == null ? next.keys() : next.diff(resource.data).affectedKeys();
      return request.auth.uid != uid
        && (!('addedBy' in changed)
            || (next.addedBy.keys().hasOnly(['uid', 'name']) && next.addedBy.uid == request.auth.uid))
        && (!('addedAt' in changed) || next.addedAt == request.time)
        && next.keys().hasOnly(['role', 'name', 'email', 'addedBy', 'addedAt', 'lastSignInAt'])
        // Only the person themselves stamps their sign-in (isOwnSignInStamp).
        && !('lastSignInAt' in changed)
        && next.role in ['', 'provider', 'dietitian', 'coAdmin', 'admin', 'superAdmin']
        && canActOn(previous)
        && (role() == 'superAdmin' || next.role in ['', 'provider', 'dietitian', 'coAdmin']);
    }

    // Each admin sign-in stamps the person's own record with the server's
    // time (Staff page "Last sign in"). Only that one field, only their own.
    function isOwnSignInStamp(uid) {
      return request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSignInAt'])
        && request.resource.data.lastSignInAt == request.time;
    }

    match /user/{uid} {
      // Clinicians read the staff list (the calendar books for any of them);
      // super admins stay hidden from everyone but super admins.
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || role() == 'superAdmin'
            || (isClinical() && resource.data.role in ['', 'provider', 'dietitian', 'coAdmin', 'admin']));
      allow create: if request.auth != null && isRoleChange(uid);
      allow update: if request.auth != null && (isRoleChange(uid) || isOwnSignInStamp(uid));
      allow delete: if request.auth != null
        && request.auth.uid != uid
        && canActOn(resource.data.get('role', ''));
    }

    // HIPAA audit controls: a record of who opened or deleted which patient
    // record, and when. Append-only for every tier — no client, not even a
    // superAdmin, may edit or delete an entry, because an audit trail its own
    // users can rewrite is not evidence of anything. Entries can only be
    // written attributed to the account actually making the request, so one
    // staff member cannot forge activity under another's name.
    function isOwnAuditEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly([
            'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'targetLabel', 'at'
          ])
        && data.actorUid == request.auth.uid
        && data.actorEmail is string && data.actorEmail.size() <= 200
        && data.action is string && data.action.size() > 0 && data.action.size() <= 60
        && data.targetCollection is string && data.targetCollection.size() <= 60
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 200
        && data.targetLabel is string && data.targetLabel.size() <= 200
        && data.at is string && data.at.size() > 0;
    }

    match /auditLog/{entryId} {
      allow read: if role() == 'superAdmin';
      // isClinical, not isStaff: a provider opening a chart or signing a note
      // has to land in the trail too.
      allow create: if isClinical() && isOwnAuditEntry();
      allow update, delete: if false;
    }

    // The contact page has the same no-login constraint as intake, so create
    // is open the same way — but this is a lead ("call me back"), not a
    // clinical record: no DOB, no medical history, no signature. It's still a
    // visitor's name, phone and email, so read stays staff-only regardless.
    function isWellFormedContactMessage() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'phone', 'email', 'interest', 'message', 'submittedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.interest is string && data.interest.size() > 0 && data.interest.size() <= 100
        && data.message is string && data.message.size() <= 2000;
    }

    // Anonymous page-view and click counts (lib/siteEvents.js), sent only after
    // a visitor accepts the privacy banner. Exactly this shape and nothing else,
    // so no one can smuggle personal data in: a type, a path, a short label, the
    // day, and the server's own time. Never the account or admin, and on the
    // intake only a page view, never a click (lib/track.js draws the same line).
    // The rules cannot rate-limit, so a script could pad the counts; see the
    // ponytail note in lib/siteEvents.js.
    function isWellFormedSiteEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'path', 'label', 'day', 'at'])
        && data.type in ['pageview', 'click']
        && data.path is string && data.path.size() <= 120 && data.path.matches('^/[a-z0-9/-]*$')
        && !data.path.matches('^/(account|admin)(/.*)?$')
        && (data.type == 'pageview' || !data.path.matches('^/intake(/.*)?$'))
        && data.label is string && data.label.size() <= 80
        && data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.at == request.time;
    }

    match /siteEvents/{eventId} {
      allow read: if isStaff();
      allow create: if isWellFormedSiteEvent();
      allow update, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow read: if isStaff();
      allow create: if isWellFormedContactMessage();
      allow update: if false;
      allow delete: if role() == 'superAdmin';
    }

    // A patient fills this in before they have an account, so submitting must
    // not require a login. Submitting is not the same as reading, though: these
    // records are PHI, and `read` stays staff-only. If read were opened to
    // match, anyone on the internet could download every patient's date of
    // birth, address, medications and signature — the Firebase config needed to
    // do it is public in the JS bundle by design.
    //
    // The clinical fields the patient submitted are still write-once — an open
    // `update` there would let anyone overwrite or blank out a record they
    // never submitted. The one exception is the admission workflow: staff
    // toggling status (pending/admitted/declined) and an internal note. This
    // checks only the fields that actually changed, so it cannot be used to
    // smuggle an edit into demographics, medical history, consent, etc.
    function isStatusUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['status', 'adminNote'])
        && (!changedKeys.hasAny(['status'])
            || request.resource.data.status in ['pending', 'admitted', 'declined'])
        && (!changedKeys.hasAny(['adminNote'])
            || (request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 2000));
    }

    match /intakeRecords/{recordId} {
      allow read: if isClinical();
      allow create: if isWellFormedIntake();
      allow update: if isAdmitter() && isStatusUpdate();
      // Deletion is the one destructive action here, so it stays on the
      // superAdmin tier rather than every admin — matching the split already
      // described above.
      allow delete: if role() == 'superAdmin';
    }

    // One doc per patient login, linking it to their intake record:
    // { email, intakeId, firstName, inviteId, linkedAt }. Named patientAccounts
    // so it can't be confused with patients/{chartId}, the clinical charts.
    // Self sign-up is gone (invite-only, Louie 2026-10-02); old sign-up docs
    // without an intakeId read as "portal not set up yet" in Account.jsx. A
    // patient reads only their own; clinical staff read them for the chart's
    // portal status.
    match /patientAccounts/{uid} {
      // A patient links their own login from /portal/setup, only against a
      // sent, unexpired invite to the same email, copying its name. Knowing
      // the invite's id (from the emailed link) is the proof. Once written, a
      // link never changes.
      function isOwnInviteLink() {
        let data = request.resource.data;
        let invite = get(/databases/$(database)/documents/patients/$(data.intakeId)/invites/$(data.inviteId)).data;
        return request.auth != null
          && request.auth.uid == uid
          && data.keys().hasAll(['email', 'intakeId', 'firstName', 'inviteId', 'linkedAt'])
          && data.keys().hasOnly(['email', 'intakeId', 'firstName', 'inviteId', 'linkedAt'])
          && data.intakeId is string && data.inviteId is string
          && data.email == request.auth.token.email
          && data.linkedAt == request.time
          && invite.status == 'sent'
          && invite.to == request.auth.token.email
          && request.time < invite.sentAt + duration.value(7, 'd')
          && data.firstName == invite.firstName;
      }
      allow read: if (request.auth != null && request.auth.uid == uid) || isClinical();
      allow create: if isOwnInviteLink();
      allow update, delete: if false;
    }

    // --- Patient charts ------------------------------------------------------
    // One chart per admitted applicant, id = the intake record's id. PHI: the
    // same BAA requirement as intakeRecords. A medical record, so nothing
    // under it is ever deleted: a chart goes inactive, a signed note gets
    // addenda. Every timestamp that proves when something happened is
    // request.time, so a client can't backdate it.
    function isNewChart(chartId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
            'intakeRecordId', 'firstName', 'lastName', 'dateOfBirth', 'sexAssignedAtBirth',
            'status', 'admittedAt', 'admittedBy', 'updatedAt', 'lastNote'
          ])
        && data.intakeRecordId == chartId
        && data.status == 'active'
        && data.admittedAt == request.time
        && data.updatedAt == request.time
        && data.admittedBy.uid == request.auth.uid
        && data.admittedBy.name == myName()
        && data.lastNote == null
        // Only for an intake that is admitted once this batch lands.
        && getAfter(/databases/$(database)/documents/intakeRecords/$(chartId)).data.status == 'admitted';
    }

    // An exercise prescription: whole numbers in range or null, a known
    // intensity, short text. Nothing else.
    function isExercisePlan(plan) {
      return plan is map
        && plan.keys().hasOnly(['daysPerWeek', 'intensity', 'minutesPerSession', 'kind', 'notes'])
        && (plan.get('daysPerWeek', null) == null
            || (plan.daysPerWeek is int && plan.daysPerWeek >= 0 && plan.daysPerWeek <= 7))
        && (plan.get('minutesPerSession', null) == null
            || (plan.minutesPerSession is int && plan.minutesPerSession >= 0 && plan.minutesPerSession <= 300))
        && plan.get('intensity', '') in ['', 'light', 'moderate', 'vigorous']
        && plan.get('kind', '') is string && plan.get('kind', '').size() <= 500
        && plan.get('notes', '') is string && plan.get('notes', '').size() <= 2000;
    }

    function isNoteShape(data) {
      return data.keys().hasOnly([
            'type', 'status', 'authorUid', 'authorName', 'authorRole', 'createdAt', 'updatedAt',
            'visitDate', 'sections', 'vitals', 'prescriptions', 'nextFollowUp', 'signedAt', 'signedBy',
            'exercisePlan'
          ])
        && data.type in ['consultation', 'progress', 'dietitian', 'exercise']
        && data.sections is map
        && data.vitals is map
        && data.prescriptions is list && data.prescriptions.size() <= 30
        // Medication lives only in the medical record.
        && (data.type in ['consultation', 'progress'] || data.prescriptions.size() == 0)
        && (!('exercisePlan' in data) || (data.type == 'exercise' && isExercisePlan(data.exercisePlan)));
    }

    match /patients/{chartId} {
      allow read: if isClinical();
      allow create: if isAdmitter() && isNewChart(chartId);
      // lastNote (the list's "Last note" column) is only ever written by a
      // signing, so it must look like one: a note type and the server's time.
      allow update: if isClinical()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastNote'])
        // Only an admitter moves a chart between active and inactive; the
        // dietitian's signings still update lastNote.
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) || isAdmitter())
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.updatedAt == request.time
        && (!('lastNote' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.lastNote.keys().hasOnly(['type', 'signedAt'])
                && request.resource.data.lastNote.type in ['consultation', 'progress', 'dietitian', 'exercise']
                && request.resource.data.lastNote.signedAt == request.time));
      allow delete: if false;

      // Drafts are visible only to their author; signed notes to every
      // clinician. A note is created as a draft by its own author, edited only
      // by that author while it's a draft, and signed exactly once with the
      // server's time and the signer's real identity. After that it never
      // changes again.
      match /notes/{noteId} {
        allow read: if isClinical()
          && (resource.data.status == 'signed' || resource.data.authorUid == request.auth.uid);
        allow create: if isClinical()
          && canWriteType(request.resource.data.type)
          && isNoteShape(request.resource.data)
          && request.resource.data.status == 'draft'
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == myName()
          && request.resource.data.authorRole == role()
          && request.resource.data.createdAt == request.time
          && request.resource.data.signedAt == null
          && request.resource.data.signedBy == null
          && get(/databases/$(database)/documents/patients/$(chartId)).data.status == 'active';
        allow update: if isClinical()
          && canWriteType(resource.data.type)
          && resource.data.status == 'draft'
          && resource.data.authorUid == request.auth.uid
          && isNoteShape(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'visitDate', 'sections', 'vitals', 'prescriptions', 'nextFollowUp', 'exercisePlan',
               'updatedAt', 'status', 'signedAt', 'signedBy'
             ])
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.status == 'draft'
              && request.resource.data.signedAt == null
              && request.resource.data.signedBy == null)
            || (request.resource.data.status == 'signed'
              && request.resource.data.signedAt == request.time
              && request.resource.data.signedBy.keys().hasOnly(['uid', 'name', 'role'])
              && request.resource.data.signedBy.uid == request.auth.uid
              && request.resource.data.signedBy.name == myName()
              && request.resource.data.signedBy.role == role())
          );
        allow delete: if isClinical()
          && resource.data.status == 'draft'
          && resource.data.authorUid == request.auth.uid;

        // Addenda: the only way to change a signed note. Each is attributed
        // to whoever writes it, stamped with the server's time, and permanent.
        match /amendments/{amendmentId} {
          allow read: if isClinical();
          allow create: if isClinical()
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorRole', 'at'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 5000
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName == myName()
            && request.resource.data.authorRole == role()
            && request.resource.data.at == request.time
            && get(/databases/$(database)/documents/patients/$(chartId)/notes/$(noteId)).data.status == 'signed'
            // A dietitian adds addenda only to dietitian notes.
            && (role() != 'dietitian'
                || get(/databases/$(database)/documents/patients/$(chartId)/notes/$(noteId)).data.type == 'dietitian');
          allow update, delete: if false;
        }
      }

      // Portal invites (Louie, 2026-10-05): the admin saves one as 'ready',
      // sends it through EmailJS, then marks it 'sent' or 'failed'. The id is
      // 128 random bits; the signed-out /portal/setup page may get a sent one
      // by its id for 7 days (the emailed link is the proof), never list them.
      match /invites/{inviteId} {
        function isNewInvite() {
          let data = request.resource.data;
          let chart = get(/databases/$(database)/documents/patients/$(chartId)).data;
          let intake = get(/databases/$(database)/documents/intakeRecords/$(chartId)).data;
          return data.keys().hasOnly(['to', 'firstName', 'subject', 'message', 'status', 'createdBy', 'createdAt'])
            && chart.status == 'active'
            && data.status == 'ready'
            && data.to == intake.demographics.email.lower().trim()
            && data.firstName is string && data.firstName.size() <= 100
            && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
            && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
            && data.createdBy.keys().hasOnly(['uid', 'name'])
            && data.createdBy.uid == request.auth.uid
            && data.createdBy.name == myName()
            && data.createdAt == request.time;
        }
        function isSendResult() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return resource.data.status == 'ready'
            && ((changed.hasOnly(['status', 'sentAt']) && request.resource.data.status == 'sent'
                 && request.resource.data.sentAt == request.time)
             || (changed.hasOnly(['status', 'error']) && request.resource.data.status == 'failed'
                 && request.resource.data.error is string && request.resource.data.error.size() <= 300));
        }
        allow get: if isClinical()
          || (resource.data.status == 'sent' && request.time < resource.data.sentAt + duration.value(7, 'd'));
        allow list: if isClinical();
        allow create: if isAdmitter() && isNewInvite();
        allow update: if isAdmitter() && isSendResult();
        allow delete: if false;
      }

      // Portal updates (spec 2026-10-05-portal-updates-design): short dated
      // messages from staff that the patient reads in the portal. Posted by a
      // clinician as themselves; afterwards only two changes: the author
      // records whether the "new update" email went out, and the author or
      // co-admin and up removes it from the patient's view. Never edited,
      // never deleted. The linked patient reads only updates not removed, so
      // their list query must filter removed == false.
      match /updates/{updateId} {
        function isNewUpdate() {
          let data = request.resource.data;
          return data.keys().hasOnly(['body', 'author', 'createdAt', 'email', 'fromNoteId', 'removed'])
            && data.keys().hasAll(['body', 'author', 'createdAt', 'email', 'fromNoteId', 'removed'])
            && get(/databases/$(database)/documents/patients/$(chartId)).data.status == 'active'
            && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
            && data.author.keys().hasOnly(['uid', 'name', 'role'])
            && data.author.uid == request.auth.uid
            && data.author.name == myName()
            && data.author.role == role()
            && data.createdAt == request.time
            && data.email == 'none'
            && (data.fromNoteId == null || (data.fromNoteId is string && data.fromNoteId.size() <= 200))
            && data.removed == false;
        }
        function isEmailResult() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
            && resource.data.email == 'none'
            && request.resource.data.email in ['sent', 'failed']
            && resource.data.author.uid == request.auth.uid;
        }
        function isRemoval() {
          let removed = request.resource.data.removed;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed'])
            && resource.data.removed == false
            && removed is map
            && removed.keys().hasOnly(['by', 'at'])
            && removed.by.keys().hasOnly(['uid', 'name'])
            && removed.by.uid == request.auth.uid
            && removed.by.name == myName()
            && removed.at == request.time
            && (resource.data.author.uid == request.auth.uid || isStaff());
        }
        allow read: if isClinical()
          || (request.auth != null
              && resource.data.removed == false
              && get(/databases/$(database)/documents/patientAccounts/$(request.auth.uid)).data.intakeId == chartId);
        allow create: if isClinical() && isNewUpdate();
        allow update: if isClinical() && (isEmailResult() || isRemoval());
        allow delete: if false;
      }

      // Track progress (spec 2026-10-06-portal-track-progress-design). Visit
      // entries are written in the note-signing batch and must carry exactly
      // the signed note's date and vitals. Home entries are the linked
      // patient's own weigh-ins, which they can mark removed (never erase).
      // The baseline is the intake's height and weights, copied as-is by
      // staff. The patient reads what isn't removed, so their query must
      // filter removed == false.
      match /progress/{entryId} {
        function isLinkedPatient() {
          return request.auth != null
            && get(/databases/$(database)/documents/patientAccounts/$(request.auth.uid)).data.intakeId == chartId;
        }
        function isRecentDay(day) {
          let parts = day.split('-');
          let at = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
          return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && at <= request.time + duration.value(1, 'd')
            && at >= request.time - duration.value(31, 'd');
        }
        function isVisitEntry() {
          let data = request.resource.data;
          let note = getAfter(/databases/$(database)/documents/patients/$(chartId)/notes/$(data.noteId)).data;
          return data.keys().hasOnly(['source', 'date', 'weightLb', 'systolic', 'diastolic', 'heartRate', 'noteId', 'createdAt', 'removed'])
            && data.keys().hasAll(['source', 'date', 'weightLb', 'systolic', 'diastolic', 'heartRate', 'noteId', 'createdAt', 'removed'])
            && data.source == 'visit'
            && data.noteId is string
            && entryId == 'visit-' + data.noteId
            && note.status == 'signed'
            && data.date == note.visitDate
            && data.weightLb == note.vitals.get('weightLb', null)
            && data.systolic == note.vitals.get('systolic', null)
            && data.diastolic == note.vitals.get('diastolic', null)
            && data.heartRate == note.vitals.get('heartRate', null)
            && data.createdAt == request.time
            && data.removed == false;
        }
        function isHomeEntry() {
          let data = request.resource.data;
          return data.keys().hasOnly(['source', 'date', 'weightLb', 'createdAt', 'removed'])
            && data.keys().hasAll(['source', 'date', 'weightLb', 'createdAt', 'removed'])
            && data.source == 'home'
            && data.weightLb is number && data.weightLb >= 50 && data.weightLb <= 800
            && data.date is string && isRecentDay(data.date)
            && data.createdAt == request.time
            && data.removed == false;
        }
        function isBaseline() {
          let data = request.resource.data;
          let intake = get(/databases/$(database)/documents/intakeRecords/$(chartId)).data.get('vitals', {});
          return entryId == 'baseline'
            && data.keys().hasOnly(['source', 'heightFeet', 'heightInches', 'currentWeightLb', 'goalWeightLb', 'removed'])
            && data.keys().hasAll(['source', 'heightFeet', 'heightInches', 'currentWeightLb', 'goalWeightLb', 'removed'])
            && data.source == 'baseline'
            && data.heightFeet == intake.get('heightFeet', '')
            && data.heightInches == intake.get('heightInches', '')
            && data.currentWeightLb == intake.get('currentWeightLb', '')
            && data.goalWeightLb == intake.get('goalWeightLb', '')
            && data.removed == false;
        }
        function isRemoval() {
          return resource.data.source == 'home'
            && resource.data.removed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed'])
            && request.resource.data.removed == request.time;
        }
        allow read: if isClinical() || (resource.data.removed == false && isLinkedPatient());
        allow create: if (isClinical() && (isVisitEntry() || isBaseline())) || (isLinkedPatient() && isHomeEntry());
        allow update: if isLinkedPatient() && isRemoval();
        allow delete: if false;
      }
    }

    // The default portal-invite wording. Co-admin and up change it.
    match /settings/portalInvite {
      allow read: if isClinical();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['subject', 'message', 'updatedBy', 'updatedAt'])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.updatedBy.keys().hasOnly(['uid', 'name'])
        && request.resource.data.updatedBy.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // --- Appointments --------------------------------------------------------
    // Booked by any clinician for any patient or applicant (intakeId is the
    // intake record's id, which becomes the chart id on admission). Who added
    // it is fixed at creation; every later change lands in the same batch as
    // an append-only history entry (changes/{id}) naming who made it, and
    // only co-admins and up read that history (Louie, 2026-10-02). Nothing is
    // deleted: an appointment is cancelled instead. PHI: patient names and
    // visit times, so the same BAA requirement as intakeRecords.
    function isAppointmentShape(data) {
      return data.keys().hasOnly([
            'intakeId', 'patientName', 'staffUid', 'staffName', 'discipline', 'start', 'minutes',
            'status', 'note', 'addedBy', 'addedAt', 'updatedAt', 'lastChangeId'
          ])
        && data.intakeId is string
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 200
        && data.staffUid is string && data.staffUid.size() > 0 && data.staffUid.size() <= 200
        && data.staffName is string && data.staffName.size() <= 200
        && data.discipline in ['medical', 'dietitian', 'exercise']
        && data.start is timestamp
        && data.minutes in [15, 30, 45, 60]
        && data.status in ['scheduled', 'completed', 'cancelled', 'noShow']
        && data.note is string && data.note.size() <= 500;
    }

    function isMe(by) {
      return by is map
        && by.keys().hasOnly(['uid', 'name', 'role'])
        && by.uid == request.auth.uid
        && by.name == myName()
        && by.role == role();
    }

    match /appointments/{appointmentId} {
      allow read: if isClinical();
      allow create: if isClinical()
        && isAppointmentShape(request.resource.data)
        && !('lastChangeId' in request.resource.data)
        // Checked on create only: intakeId never changes afterwards, and a
        // deleted intake record mustn't freeze its appointments forever.
        && exists(/databases/$(database)/documents/intakeRecords/$(request.resource.data.intakeId))
        && request.resource.data.status == 'scheduled'
        && isMe(request.resource.data.addedBy)
        && request.resource.data.addedAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Only a scheduled appointment changes, only these fields, and only
      // with a brand-new history entry written in the same batch.
      allow update: if isClinical()
        && resource.data.status == 'scheduled'
        && isAppointmentShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'start', 'minutes', 'staffUid', 'staffName', 'status', 'note', 'updatedAt', 'lastChangeId'
           ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastChangeId is string
        && request.resource.data.lastChangeId != resource.data.get('lastChangeId', '')
        && !exists(/databases/$(database)/documents/appointments/$(appointmentId)/changes/$(request.resource.data.lastChangeId))
        && existsAfter(/databases/$(database)/documents/appointments/$(appointmentId)/changes/$(request.resource.data.lastChangeId));
      allow delete: if false;

      match /changes/{changeId} {
        allow read: if isStaff();
        allow create: if isClinical()
          && request.resource.data.keys().hasOnly(['kind', 'from', 'to', 'reason', 'by', 'at'])
          && request.resource.data.kind in ['moved', 'cancelled', 'completed', 'noShow', 'noteEdited']
          && request.resource.data.from is map
          && request.resource.data.to is map
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
          && isMe(request.resource.data.by)
          && request.resource.data.at == request.time
          // Only as part of the appointment update that it explains.
          && getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('lastChangeId', '') == changeId;
        allow update, delete: if false;
      }
    }

    // --- Staff to-dos ----------------------------------------------------------
    // Added on the To-do page (Louie, 2026-10-02). "me" items are only ever
    // readable by their author; "everyone" items by any clinician. Only the
    // author edits the content; anyone who can see an item ticks it, as
    // themselves, or un-ticks it. Never deleted. Items may name a patient: PHI,
    // same BAA requirement as intakeRecords.
    function isTodoContent(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && data.intakeId is string && data.intakeId.size() <= 200
        && data.patientName is string && data.patientName.size() <= 200
        && data.due is string && (data.due == '' || data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.visibility in ['me', 'everyone'];
    }

    match /todos/{todoId} {
      allow read: if isClinical()
        && (resource.data.visibility == 'everyone' || resource.data.ownerUid == request.auth.uid);
      allow create: if isClinical()
        && request.resource.data.keys().hasOnly([
             'text', 'intakeId', 'patientName', 'due', 'visibility',
             'ownerUid', 'ownerName', 'createdAt', 'updatedAt', 'done'
           ])
        && isTodoContent(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName == myName()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.done == null;
      allow update: if isClinical()
        && (resource.data.visibility == 'everyone' || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'intakeId', 'patientName', 'due', 'visibility', 'updatedAt'])
            && isTodoContent(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'updatedAt'])
            && (request.resource.data.done == null
                || (request.resource.data.done.keys().hasOnly(['uid', 'name', 'at'])
                    && request.resource.data.done.uid == request.auth.uid
                    && request.resource.data.done.name == myName()
                    && request.resource.data.done.at == request.time)))
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
