# Firebase config for the /admin dashboard (src/admin/firebase.js).
# Copy this file to .env.local and fill in real values from the Firebase
# Console (Project settings > General > Your apps > SDK setup and config).
# Without these, isConfigured is false and /admin shows "not configured"
# (or, in dev, falls back to seeded demo data — see usingSeedData).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS, for portal invites, update and message notices (src/lib/emailjs.js).
# From the EmailJS dashboard: Email Services, Email Templates, Account > General.
# Empty = the invite dialog says "Email sending isn't set up yet."
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_UPDATE_TEMPLATE_ID=
VITE_EMAILJS_MESSAGE_TEMPLATE_ID=
VITE_EMAILJS_STAFF_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
